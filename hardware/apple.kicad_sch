		(uuid "fe271eaa-44ee-503a-88b0-58d89f57fd89")
	)
	(text "Apple II slot interface\nA0-A7, R/W, /IOSEL, /DEVSEL, PHI0, /RES go to the RP2354B directly (5 V-tolerant pads, GP8-20).\nD0-D7 pass through U2 (74LVC245A): DIR = R/W, so a 6502 read drives the slot.\nU2 /OE = (/IOSEL & /DEVSEL) | A2_DOE_N (U3): it can only drive during this slot's own cycles.\nINT / DMA daisy chains passed through; unused slot pins (A8-A15, IRQ, NMI, ...) left open."
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b5267fe0-0931-52cb-92d0-138827d7fa03")
	)
	(embedded_fonts no)
