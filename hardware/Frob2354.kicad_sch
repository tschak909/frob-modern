	(text "Frob2354 -- the FROB Apple II card (Frobco, 1982) on one RP2354B"
		(exclude_from_sim no)
		(at 45.72 25.4 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left top)
		)
		(uuid "aa387cf0-2541-546b-9c8f-29318ca8a028")
	)
	(text "Atari 2600 development: 4 KB of RAM the Apple loads through a paged window ($Cn00-$CnFF) and the 2600\nruns as cartridge ROM, plus a one-byte mailbox each way.  Register-compatible with the original\n(see firmware/README.md); J2 takes the original FROB cable and cartridge adapter."
		(exclude_from_sim no)
		(at 45.72 33.02 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "6ac6bc01-836e-5bc7-976b-a77a03aa052c")
	)
	(text "Apple $C0n0 write: D0-D3 page, D4 RAM to the 2600, D5 port on.  Read: D7 may write, D6 may read.\nApple $C0n1: mailbox.   2600 $FFF0 write / $FFF1 status / $FFF2 read (port on)."
		(exclude_from_sim no)
		(at 45.72 236.22 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "805bca68-03af-50c5-b440-9361fd273a2e")
	)
